+                    set -eu
+                    sudo -n dpkg --configure -a
+                    sudo -n apt-get -y --no-upgrade -o APT::Get::AllowUnauthenticated=false -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 --download-only install $packageArgs
