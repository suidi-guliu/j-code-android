+data class KitDependencyStatus(val requirement: KitRequirement,val ready: Boolean,val installedVersion: String="Not detected")
+data class KitSetupPlan(val preview: PackagePreview,val dependencies: List<PackagePreview>,val status: List<KitDependencyStatus>,val scripts: Map<String,String>,val distroId: String,val architecture: String,val created: Long=System.currentTimeMillis(),val cancellationPath: String="/tmp/sui-env-cancel-kit-"+UUID.randomUUID(),val aptDownloadBytes: Long?=null)
