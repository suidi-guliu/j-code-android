+                        }
+                    } else {
+                        val language=NativeEnvironment.entries.first { it.key==r.environmentId }
+                        val query=distro.execOwned(language.queryScript(),"/tmp","sui-kit:dependency-metadata",300000)
+                        check(query.succeeded) { "Cannot query signed Ubuntu candidates: ${query.stderr.takeLast(1500)}" }
+                        val plan=NativeInstallPlan.parse(language,runtime.selectedDistro.id,query.stdout)
+                        check(plan.architecture==runtime.selectedDistro.arch.rootfsKey) { "Ubuntu architecture changed; review a fresh plan" }
+                        scripts[r.id]=plan.script(cancellationPath)
+                        val sizes=distro.execOwned("sudo -n apt-get --print-uris --download-only --yes --no-upgrade -o APT::Get::AllowUnauthenticated=false install ${plan.specifications}","/tmp","sui-kit:runtime-size",60000)
+                        status=status.map { if(it.requirement.id==r.id) it.copy(requirement=r.copy(version=plan.packages.joinToString { p -> "${p.name}: ${p.installed ?: "not installed"} → ${p.selected}" },bytes=if(sizes.succeeded) downloadSize(sizes.stdout) else null)) else it }
+                    }
+                    "ubuntu-apt" -> scripts[r.id]="""
+                        set -eu
+                        sudo -n apt-get -o Acquire::AllowInsecureRepositories=false -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update
+                        sudo -n dpkg --configure -a
+                        sudo -n apt-get -y --no-upgrade -o APT::Get::AllowUnauthenticated=false --download-only install ${r.packages.joinToString(" ",transform=::shellQuote)}
+                        [ ! -f "${'$'}{SUI_KIT_CANCEL}" ] || exit 130
+                        sudo -n apt-get -y --no-upgrade -o APT::Get::AllowUnauthenticated=false --no-download install ${r.packages.joinToString(" ",transform=::shellQuote)}
+                    """.trimIndent()
+                    "kit-resource" -> scripts[r.id]=preview.pack.content(r.resource!!).toString(Charsets.UTF_8)
+                }
+            }
+            var aptDownloadBytes: Long?=null
+            val aptRows=status.filter { !it.ready && it.requirement.provider=="ubuntu-apt" }
+            if(aptRows.isNotEmpty()) {
+                val packages=aptRows.flatMap { it.requirement.packages }.distinct()
+                val query="""
+                    set -eu
+                    sudo -n apt-get -o Acquire::AllowInsecureRepositories=false -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update >&2
+                    for p in ${packages.joinToString(" ",transform=::shellQuote)}; do
+                        printf 'SUI_APT\t%s\t' "${'$'}p"
