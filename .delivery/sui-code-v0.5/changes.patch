+                    }
+                }
+                visiting.remove(pack.id)
+            }
+            collect(preview.pack)
+            var status=inspect(preview.pack,true)
+            val runtime=distro.environmentState.value.runtime
+            val scripts=mutableMapOf<String,String>()
+            val cancellationPath="/tmp/sui-env-cancel-kit-"+UUID.randomUUID()
+            status.filter { !it.ready }.forEach { row ->
+                val r=row.requirement
+                when(r.provider) {
+                    "environment" -> if(r.environmentId=="java") {
+                        val existing=JavaInstallationScript.managedDirectory(distro.activeRootfsPath()).listFiles().orEmpty().filter {
+                            it.isDirectory && !java.nio.file.Files.isSymbolicLink(it.toPath()) && it.name.matches(Regex("temurin-[A-Za-z0-9.+_-]+-${if(runtime.selectedDistro.arch==Arch.ARM64) "aarch64" else "x64"}")) && File(it,"bin/java").isFile && File(it,"bin/javac").isFile
+                        }.sortedByDescending { it.lastModified() }.firstOrNull()
+                        if(existing!=null) {
+                            val home="/opt/sui-code/jdks/${existing.name}"
+                            scripts[r.id]=JavaInstallationScript.select(home)
+                            status=status.map { if(it.requirement.id==r.id) it.copy(requirement=r.copy(version="Verify and reuse existing ${existing.name}; repair environment selection",bytes=0)) else it }
+                        } else {
+                            val release=JavaReleaseProvider.latest(runtime.selectedDistro.arch.rootfsKey)
+                            scripts[r.id]=JavaInstallScript.build(release).replace("echo '2/5", "[ ! -f ${shellQuote(cancellationPath)} ] || exit 130\necho '2/5").replace("echo '3/5", "[ ! -f ${shellQuote(cancellationPath)} ] || exit 130\necho '3/5").replace("echo '5/5", "[ ! -f ${shellQuote(cancellationPath)} ] || exit 130\necho '5/5")
