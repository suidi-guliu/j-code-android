+                status=status.map { row -> if(row.requirement.provider=="ubuntu-apt" && !row.ready) row.copy(requirement=row.requirement.copy(version=row.requirement.packages.joinToString { "$it=${candidates[it]}" })) else row }
+            }
+            KitSetupPlan(preview,deps,status,scripts,runtime.selectedDistro.id,runtime.selectedDistro.arch.rootfsKey,cancellationPath=cancellationPath,aptDownloadBytes=aptDownloadBytes)
+        } finally { mutable.update { it.copy(busy=false) } }
+    }
