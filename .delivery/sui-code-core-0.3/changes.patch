--- /dev/null
+++ b/core/distro/src/main/java/dev/blamspot/jcode/core/distro/NativeEnvironment.kt
@@ -0,0 +1,107 @@
+package dev.blamspot.jcode.core.distro
+
+/** Fixed Ubuntu packages, never marketplace extensions or arbitrary shell entered by a user. */
+enum class NativeEnvironment(val key: String, val title: String, val packages: List<String>, val tool: String, val variable: String) {
+    C("c", "C (GCC)", listOf("gcc", "libc6-dev"), "gcc", "SUI_C"),
+    Cpp("cpp", "C++ (G++)", listOf("g++", "libc6-dev"), "g++", "SUI_CPP"),
+    Python("python", "Python 3", listOf("python3", "python3-venv", "python3-pip"), "python3", "SUI_PYTHON");
+
+    val catalogId get() = "sui-$key"
+    fun queryScript(): String = """
+        set -eu
+        . /etc/os-release
+        [ "${'$'}ID" = ubuntu ] || { echo 'Only the Ubuntu distribution package channel is supported.' >&2; exit 1; }
+        export LC_ALL=C
+        sudo -n apt-get -o Acquire::AllowInsecureRepositories=false -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update >&2
+        for p in ${packages.joinToString(" ")}; do
+            installed=${'$'}(dpkg-query -W -f='${'$'}{db:Status-Abbrev}${'$'}{Version}' "${'$'}p" 2>/dev/null || true)
+            case "${'$'}installed" in 'ii '*|'hi '*) installed=${'$'}{installed#* } ;; *) installed=- ;; esac
+            candidate=${'$'}(apt-cache policy "${'$'}p" | sed -n 's/^[[:space:]]*Candidate: //p' | head -1)
+            printf 'PKG\t%s\t%s\t%s\n' "${'$'}p" "${'$'}installed" "${'$'}candidate"
+        done
+        apt-cache policy ${packages.joinToString(" ")} >&2
+        dpkg --print-architecture
+    """.trimIndent()
+
+    fun smoke(toolPath: String): String = when (this) {
+        C, Cpp -> """
+            printf '%s\n' '#include <stdio.h>' 'int main(void) { puts("SUI_NATIVE_READY"); return 0; }' > "${'$'}TMP/main.${if (this == C) "c" else "cpp"}"
+            ${shellQuote(toolPath)} "${'$'}TMP/main.${if (this == C) "c" else "cpp"}" -o "${'$'}TMP/program"
+            [ "${'$'}("${'$'}TMP/program")" = SUI_NATIVE_READY ]
+        """.trimIndent()
+        Python -> "${shellQuote(toolPath)} -c 'import sys; assert sys.version_info.major == 3; print(\"SUI_NATIVE_READY\")'\n${shellQuote(toolPath)} -m venv \"\$TMP/venv\""
+    }
+}
+
+data class NativePackage(val name: String, val installed: String?, val candidate: String) {
+    init {
+        require(name.matches(Regex("[a-z0-9][a-z0-9+.-]*")))
+        require(candidate.matches(Regex("[A-Za-z0-9:.+~_-]+")))
+        require(installed == null || installed.matches(Regex("[A-Za-z0-9:.+~_-]+")))
+    }
+    val selected get() = installed ?: candidate
+}
+
+data class NativeInstallPlan(val language: NativeEnvironment, val packages: List<NativePackage>, val distroId: String, val architecture: String) {
+    init {
+        require(architecture in setOf("arm64", "amd64"))
+        require(packages.map { it.name } == language.packages)
+    }
+    val specifications get() = packages.joinToString(" ") { shellQuote("${it.name}=${it.selected}") }
+
+    fun script(cancelFile: String): String {
+        require(cancelFile.matches(Regex("/tmp/sui-env-cancel-[a-zA-Z0-9-]+")))
+        val lang = language
+        val existingSmoke = lang.smoke("/usr/bin/${lang.tool}").replace(shellQuote("/usr/bin/${lang.tool}"), "\"\$SELECTED\"")
+        return """
+            set -eu
+            umask 022
+            ENV_FILE=/opt/sui-code/${lang.key}.env
+            CANCEL=${shellQuote(cancelFile)}
+            check_cancel() { [ ! -f "${'$'}CANCEL" ] || { echo 'Cancelled at a safe boundary. Package operations already completed are retained; previous environment selection is unchanged.'; exit 130; }; }
+            mkdir -p /opt/sui-code
+            TMP=${'$'}(mktemp -d /opt/sui-code/.${lang.key}-install-XXXXXX)
+            trap 'rm -rf -- "${'$'}TMP"' EXIT
+            check_cancel
+            if [ -r "${'$'}ENV_FILE" ]; then
+                . "${'$'}ENV_FILE"
+                SELECTED="${'$'}{${lang.variable}:-}"
+                if [ -n "${'$'}SELECTED" ] && [ -x "${'$'}SELECTED" ] && "${'$'}SELECTED" --version; then
+                    $existingSmoke
+                    check_cancel
+                    echo 'Existing managed ${lang.title} is usable and preserved. No packages or environment files changed.'
+                    exit 0
+                fi
+            fi
+            echo '1/4 Repairing only pending package configuration, if any'
+            sudo -n dpkg --configure -a
+            check_cancel
+            echo '2/4 Downloading reviewed Ubuntu packages; apt verifies signed metadata and package hashes'
+            sudo -n apt-get -y -o APT::Get::AllowUnauthenticated=false -o Acquire::AllowInsecureRepositories=false -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 --download-only --no-upgrade install $specifications
+            check_cancel
+            echo '3/4 Installing downloaded packages; cancellation waits for dpkg to finish safely'
+            sudo -n apt-get -y -o APT::Get::AllowUnauthenticated=false --no-download --no-upgrade install $specifications
+            check_cancel
+            echo '4/4 Verifying tool and compiling/running a smoke program before activation'
+            /usr/bin/${lang.tool} --version
+            ${lang.smoke("/usr/bin/${lang.tool}")}
+            check_cancel
+            printf '%s\n' 'export ${lang.variable}=/usr/bin/${lang.tool}' > "${'$'}TMP/environment"
+            chmod 644 "${'$'}TMP/environment"
+            mv -f "${'$'}TMP/environment" "${'$'}ENV_FILE"
+            echo 'SUI_NATIVE_READY — ${lang.title}. Existing JDKs and system defaults were not replaced.'
+        """.trimIndent()
+    }
+
+    companion object {
+        fun parse(language: NativeEnvironment, distro: String, output: String): NativeInstallPlan {
+            val lines = output.lines()
+            val pkgs = lines.filter { it.startsWith("PKG\t") }.map { line ->
+                val values = line.split('\t')
+                require(values.size == 4) { "Invalid Ubuntu package metadata" }
+                NativePackage(values[1], values[2].takeUnless { it == "-" }, values[3])
+            }
+            return NativeInstallPlan(language, pkgs, distro, lines.lastOrNull { it in setOf("arm64", "amd64") } ?: error("Ubuntu architecture was not reported"))
+        }
+    }
+}
diff --git a/core/distro/src/main/java/dev/blamspot/jcode/core/distro/NativeEnvironmentManager.kt b/core/distro/src/main/java/dev/blamspot/jcode/core/distro/NativeEnvironmentManager.kt
new file mode 100644
index 0000000..ea3190b
--- /dev/null
+++ b/core/distro/src/main/java/dev/blamspot/jcode/core/distro/NativeEnvironmentManager.kt
@@ -0,0 +1,90 @@
+package dev.blamspot.jcode.core.distro
+
+import java.io.File
+import java.util.UUID
+import kotlinx.coroutines.*
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+
+/** Shares the existing Setup PTY. Cancellation is cooperative across apt/dpkg safe boundaries. */
+class NativeEnvironmentManager(private val distro: DistroService) {
+    data class State(val busy: Boolean = false, val installing: Boolean = false, val plan: NativeInstallPlan? = null,
+        val message: String = "Query Ubuntu packages, review the versions, then confirm installation.", val log: String = "", val logPath: String? = null)
+    private val mutable = MutableStateFlow(State())
+    val state = mutable.asStateFlow()
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private var job: Job? = null
+    @Volatile private var cancellationFile: File? = null
+
+    @Synchronized fun query(language: NativeEnvironment) {
+        if (job?.isActive == true) return
+        mutable.value = State(busy = true, message = "Refreshing signed Ubuntu package metadata…")
+        val runtime = distro.environmentState.value.runtime
+        job = scope.launch {
+            try {
+                check(distro.isRuntimeReady()) { "Complete the existing Ubuntu setup first." }
+                val result = distro.exec(language.queryScript(), timeoutMs = 240_000)
+                coroutineContext.ensureActive()
+                check(result.succeeded) { result.stderr.ifBlank { result.internalError ?: "Ubuntu package query failed." } }
+                val plan = NativeInstallPlan.parse(language, runtime.selectedDistro.id, result.stdout)
+                check(plan.architecture == runtime.selectedDistro.arch.rootfsKey) { "Ubuntu architecture does not match the selected environment." }
+                mutable.update { it.copy(plan = plan, log = result.stderr.takeLast(65536), message = "Review the Ubuntu package versions before installation. Installed versions are preserved.") }
+            } catch (cancel: CancellationException) { mutable.update { it.copy(message = "Query cancelled.") }; throw cancel
+            } catch (error: Exception) { mutable.update { it.copy(message = error.message ?: "Package query failed; retry when connected.") }
+            } finally { mutable.update { it.copy(busy = false) } }
+        }
+    }
+
+    @Synchronized fun install(plan: NativeInstallPlan) {
+        if (job?.isActive == true || plan != mutable.value.plan) return
+        job = scope.launch {
+            var poller: Job? = null
+            var logFile: File? = null
+            try {
+                check(distro.isRuntimeReady() && distro.environmentState.value.runtime.selectedDistro.id == plan.distroId) { "Ubuntu changed; query again." }
+                val runner = distro.interactiveJavaRunner ?: error("Setup terminal is unavailable; reopen the workbench.")
+                val token = UUID.randomUUID().toString()
+                val cancelPath = "/tmp/sui-env-cancel-$token"
+                cancellationFile = File(distro.activeRootfsPath(), cancelPath.removePrefix("/"))
+                val logPath = "/opt/sui-code/logs/${plan.language.key}-$token.log"
+                val file = File(distro.activeRootfsPath(), logPath.removePrefix("/")); logFile = file
+                mutable.update { it.copy(busy = true, installing = true, log = "", logPath = logPath, message = "Installing ${plan.language.title}. See Setup terminal; cancellation waits for a safe package boundary.") }
+                poller = scope.launch { while (true) {
+                    if (file.isFile) mutable.update { it.copy(log = tail(file)) }
+                    delay(750)
+                } }
+                val command = "mkdir -p /opt/sui-code/logs && /bin/bash -o pipefail -c " + shellQuote("/bin/bash -c ${shellQuote(plan.script(cancelPath))} 2>&1 | tee ${shellQuote(logPath)}")
+                val result = runner("${plan.language.title} environment", command, 2_100_000, plan.distroId)
+                    ?: error("Could not open Setup terminal. Nothing was installed silently.")
+                if (result.succeeded) scope.launch { runCatching { distro.checkSdkStatuses() } }
+                mutable.update { it.copy(message = when {
+                    result.succeeded -> "${plan.language.title} verified. QuickRun is ready; the Java environment is unchanged."
+                    result.exitCode == 130 -> "Cancelled at a safe package boundary. Completed package operations are retained. You can retry."
+                    else -> "Installation failed (${result.exitCode}). ${result.internalError.orEmpty()} Inspect the log and retry; no lock files will be deleted."
+                }) }
+            } catch (error: Exception) { mutable.update { it.copy(message = error.message ?: "Native environment setup failed.") }
+            } finally { withContext(NonCancellable) {
+                poller?.cancelAndJoin()
+                logFile?.takeIf { it.isFile }?.let { f -> mutable.update { it.copy(log = tail(f)) } }
+                cancellationFile?.delete(); cancellationFile = null
+                mutable.update { it.copy(busy = false, installing = false) }
+            } }
+        }
+    }
+
+    fun cancel() {
+        if (mutable.value.installing) {
+            val written = runCatching { (cancellationFile ?: error("No active installation")).writeText("cancel\n") }
+            if (written.isFailure) { mutable.update { it.copy(message = "Could not request cancellation. Keep Setup open and wait for the current package operation.") }; return }
+            mutable.update { it.copy(message = "Cancellation requested. Waiting for apt/dpkg to finish safely; do not force-close the Setup terminal.") }
+        } else job?.cancel()
+    }
+
+    private fun tail(file: File): String = runCatching {
+        java.io.RandomAccessFile(file, "r").use { input ->
+            input.seek((input.length() - 65536).coerceAtLeast(0))
+            ByteArray((input.length() - input.filePointer).toInt()).also { input.readFully(it) }.toString(Charsets.UTF_8)
+        }
+    }.getOrDefault("See Setup terminal for logs.")
+}
diff --git a/core/distro/src/main/java/dev/blamspot/jcode/core/distro/NativeQuickRun.kt b/core/distro/src/main/java/dev/blamspot/jcode/core/distro/NativeQuickRun.kt
