@@ -0,0 +1,20 @@
+package dev.blamspot.jcode.design
+
+/** Widths are content dp, independent of the 68dp navigation rail. Never consumes the editor. */
+object WorkbenchPaneSizing {
+    const val RAIL = 68f
+    const val HANDLE = 12f
+    data class Bounds(val modal: Boolean, val minimum: Float, val maximum: Float, val width: Float)
+    fun bounds(available: Float, fontScale: Float, requested: Float?): Bounds {
+        val width=available.takeIf { it.isFinite() }?.coerceAtLeast(0f) ?: 0f
+        val scale=fontScale.takeIf { it.isFinite() }?.coerceIn(1f,1.5f) ?: 1f
+        val minimum=260f*scale
+        val editorMinimum=320f*scale
+        val modal=width < RAIL+HANDLE+minimum+editorMinimum
+        val maximum=if(modal) (width-RAIL-24f).coerceIn(0f,520f) else minOf(560f,width-RAIL-HANDLE-editorMinimum)
+        val lower=minOf(minimum,maximum)
+        val initial=(width*.30f).coerceIn(300f,420f)
+        val preferred=requested?.takeIf { it.isFinite() && it>0f } ?: initial
+        return Bounds(modal,lower,maximum,preferred.coerceIn(lower,maximum))
+    }
+}
diff --git a/core/design/src/test/java/dev/blamspot/jcode/design/WorkbenchPaneSizingTest.kt b/core/design/src/test/java/dev/blamspot/jcode/design/WorkbenchPaneSizingTest.kt
new file mode 100644
index 0000000..ed77458
--- /dev/null
+++ b/core/design/src/test/java/dev/blamspot/jcode/design/WorkbenchPaneSizingTest.kt
@@ -0,0 +1,26 @@
+package dev.blamspot.jcode.design
+import org.junit.Test
+import org.junit.Assert.*
+class WorkbenchPaneSizingTest {
+    @Test fun tabletSeparatesRailAndReservesEditor() {
+        val b=WorkbenchPaneSizing.bounds(1200f,1f,null)
+        assertFalse(b.modal);assertEquals(360f,b.width,0f);assertTrue(1200-b.width-68-12>=320)
+    }
+    @Test fun rotationSplitAndLargeFontUseDrawerWhenNeeded() {
+        assertTrue(WorkbenchPaneSizing.bounds(600f,1f,480f).modal)
+        assertTrue(WorkbenchPaneSizing.bounds(900f,1.5f,480f).modal)
+        assertFalse(WorkbenchPaneSizing.bounds(1600f,1.5f,480f).modal)
+    }
+    @Test fun restoredWidthClampsWithoutDestroyingPreference() {
+        val saved=500f
+        val narrow=WorkbenchPaneSizing.bounds(800f,1f,saved)
+        assertEquals(400f,narrow.width,0f)
+        assertEquals(saved,WorkbenchPaneSizing.bounds(1200f,1f,saved).width,0f)
+    }
+    @Test fun malformedAndTinyMeasurementsNeverProduceNegativeWidths() {
+        for(w in listOf(0f,40f,Float.NaN,Float.POSITIVE_INFINITY,800f)) {
+            val b=WorkbenchPaneSizing.bounds(w,Float.NaN,Float.NaN)
+            assertTrue(b.width.isFinite());assertTrue(b.width>=0f);assertTrue(b.maximum>=b.minimum)
+        }
+    }
+}
