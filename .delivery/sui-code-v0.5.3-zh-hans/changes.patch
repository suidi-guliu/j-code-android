+@Composable
+fun EditorTab.localizedTitle(): String = when(pageKind) {
+    EditorPageKind.Settings -> uiText("nav.settings")
+    EditorPageKind.Environment -> uiText("ui.environment")
+    EditorPageKind.Trash -> uiText("ui.trash")
