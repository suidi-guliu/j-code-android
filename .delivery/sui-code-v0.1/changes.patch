+bash gradlew --no-daemon --max-workers=4 \
+  -PjcodeApplicationId=dev.suicode.ide \
+  :app:assembleDebug :core:distro:testDebugUnitTest
+bash gradlew --no-daemon --max-workers=4 \
+  :core:config:testDebugUnitTest --rerun-tasks
