+ except subprocess.TimeoutExpired:
+  os.killpg(proc.pid,signal.SIGTERM)
+  try:proc.communicate(timeout=5)
+  except subprocess.TimeoutExpired:os.killpg(proc.pid,signal.SIGKILL);proc.communicate()
+  raise
