diff --git a/native-library/src/C_CPP/suik/resources/prepare-debug.sh b/native-library/src/C_CPP/suik/resources/prepare-debug.sh
new file mode 100644
index 0000000..53039e3
--- /dev/null
+++ b/native-library/src/C_CPP/suik/resources/prepare-debug.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+set -eu
+SOURCE=$1
+PROJECT=$2
+OUT="$PROJECT/.sui-code/debug"
+mkdir -p "$OUT"
+if [ -f "$PROJECT/CMakeLists.txt" ]; then
+    cmake -S "$PROJECT" -B "$OUT" -G Ninja -DCMAKE_BUILD_TYPE=Debug >&2
+    cmake --build "$OUT" >&2
+    PROGRAM="$OUT/app"
+    [ -x "$PROGRAM" ] || { echo 'Configure a CMake executable target named app for this Kit workflow.' >&2; exit 64; }
+else
+    case "$SOURCE" in
+        *.c) TOOL=/usr/bin/gcc; FLAGS=-std=c17; [ ! -r /opt/sui-code/c.env ] || { . /opt/sui-code/c.env; TOOL=$SUI_C; } ;;
+        *) TOOL=/usr/bin/g++; FLAGS=-std=c++20; [ ! -r /opt/sui-code/cpp.env ] || { . /opt/sui-code/cpp.env; TOOL=$SUI_CPP; } ;;
+    esac
+    PROGRAM="$OUT/program"
+    "$TOOL" "$FLAGS" -g -O0 "$SOURCE" -o "$PROGRAM" >&2
+fi
+jq -cn --arg program "$PROGRAM" '{program:$program}'
diff --git a/native-library/src/C_CPP/suik/resources/project-task.sh b/native-library/src/C_CPP/suik/resources/project-task.sh
new file mode 100644
index 0000000..24eb61b
--- /dev/null
+++ b/native-library/src/C_CPP/suik/resources/project-task.sh
@@ -0,0 +1,15 @@
+#!/bin/bash
+set -euo pipefail
+ACTION=$1
+PROJECT=$2
+[ -f "$PROJECT/CMakeLists.txt" ] || { echo 'Create or open a CMake project before Build/Test. Single files run through C/C++ Basic Plugin.' >&2; exit 64; }
+CC=/usr/bin/gcc
+CXX=/usr/bin/g++
+if [ -r /opt/sui-code/c.env ]; then . /opt/sui-code/c.env; CC=$SUI_C; fi
+if [ -r /opt/sui-code/cpp.env ]; then . /opt/sui-code/cpp.env; CXX=$SUI_CPP; fi
+[ -x "$CC" ] && [ -x "$CXX" ] || { echo 'Configured GCC/G++ cannot run' >&2; exit 78; }
+cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DCMAKE_C_COMPILER="$CC" -DCMAKE_CXX_COMPILER="$CXX" -S "$PROJECT" -B "$PROJECT/.sui-code/build" -G Ninja -DCMAKE_BUILD_TYPE=Debug
+cmake --build "$PROJECT/.sui-code/build"
+if [ "$ACTION" = test ]; then ctest --test-dir "$PROJECT/.sui-code/build" --output-on-failure; fi
+
+if [ "$ACTION" = run ]; then exec "$PROJECT/.sui-code/build/app"; fi
