@@ -0,0 +1,77 @@
+package dev.suicode.nativehost
+
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.window.Dialog
+import androidx.compose.ui.window.DialogProperties
+import dev.suicode.packages.PanelState
+import kotlinx.coroutines.launch
+import kotlinx.serialization.json.*
+
+/** Kit widgets inherit native tokens and stay inside one owned dialog surface. */
+@Composable
+fun NativeKitPanel(host: NativePackageHost,panel: PanelState) {
+    val inputs=remember(panel) { mutableStateMapOf<String,String>() }
+    val results=remember(panel) { mutableStateMapOf<String,String>() }
+    val scope=rememberCoroutineScope()
+    var busy by remember(panel) { mutableStateOf(false) }
+    var message by remember(panel) { mutableStateOf<String?>(null) }
+    fun bind(text: String): String = Regex("\\$\\{result:([a-z][a-z0-9.-]*)\\}").replace(text) { results[it.groupValues[1]] ?: "—" }
+    fun invoke(command: String) {
+        if(busy) return
+        val owner=host.panelOwner ?: return
+        busy=true;message=null
+        scope.launch {
+            try {
+                val reply=host.invoke(owner,command,inputs.toMap())
+                message=reply.code
+                reply.values.forEach { (key,value) -> results["$command.$key"]=value }
+            } catch(e: Exception) { message=e.message ?: "Native command failed" }
+            finally { busy=false }
+        }
+    }
+    Dialog(onDismissRequest=host::dismissPanel,properties=DialogProperties(usePlatformDefaultWidth=false)) {
+        Surface(Modifier.padding(24.dp).widthIn(max=840.dp).fillMaxWidth(),shape=MaterialTheme.shapes.medium) {
+            Column(Modifier.padding(24.dp).verticalScroll(rememberScrollState()),verticalArrangement=Arrangement.spacedBy(12.dp)) {
+                Text(panel.title,style=MaterialTheme.typography.titleLarge)
+                if(panel.text.isNotEmpty()) Text(panel.text)
+                if(panel.status=="loading" || busy) LinearProgressIndicator(Modifier.fillMaxWidth())
+                if(panel.status=="empty") Text("No results")
+                panel.nodes.forEach { element -> NativeNode(element.jsonObject,inputs,::bind,!busy,::invoke) }
+                message?.let { Text(it,color=MaterialTheme.colorScheme.primary) }
+                TextButton(onClick=host::dismissPanel) { Text("Close") }
+            }
+        }
+    }
+}
+
+@OptIn(androidx.compose.foundation.layout.ExperimentalLayoutApi::class)
+@Composable
+private fun NativeNode(n: JsonObject,inputs: MutableMap<String,String>,bind: (String)->String,enabled: Boolean,invoke: (String)->Unit) {
+    fun text(key: String)=n.getValue(key).jsonPrimitive.content
+    val id=text("id")
+    when(text("type")) {
+        "column" -> Column(verticalArrangement=Arrangement.spacedBy(8.dp)) { n.getValue("children").jsonArray.forEach { NativeNode(it.jsonObject,inputs,bind,enabled,invoke) } }
+        "row" -> androidx.compose.foundation.layout.FlowRow(horizontalArrangement=Arrangement.spacedBy(12.dp),verticalArrangement=Arrangement.spacedBy(8.dp)) { n.getValue("children").jsonArray.forEach { NativeNode(it.jsonObject,inputs,bind,enabled,invoke) } }
+        "text" -> Text(bind(text("text")))
+        "metric" -> Text(bind(text("text")),style=MaterialTheme.typography.headlineSmall)
+        "input" -> {
+            LaunchedEffect(id) { inputs.putIfAbsent(id,text("value")) }
+            OutlinedTextField(value=inputs[id] ?: text("value"),onValueChange={ if(it.length<=4096) inputs[id]=it },label={ Text(text("label")) },enabled=enabled,modifier=Modifier.fillMaxWidth())
+        }
+        "toggle" -> {
+            LaunchedEffect(id) { inputs.putIfAbsent(id,text("value")) }
+            Row { Switch(checked=(inputs[id] ?: text("value"))=="true",onCheckedChange={inputs[id]=it.toString()},enabled=enabled);Text(text("label"),Modifier.padding(12.dp)) }
+        }
+        "button" -> Button(onClick={invoke(text("command"))},enabled=enabled) { Text(text("label")) }
+        "table" -> Column(verticalArrangement=Arrangement.spacedBy(8.dp)) {
+            Row(Modifier.fillMaxWidth()) { n.getValue("columns").jsonArray.forEach { Text(it.jsonPrimitive.content,Modifier.weight(1f),style=MaterialTheme.typography.titleSmall) } }
+            n.getValue("rows").jsonArray.forEach { r -> Row(Modifier.fillMaxWidth()) { r.jsonArray.forEach { Text(bind(it.jsonPrimitive.content),Modifier.weight(1f)) } } }
+        }
+    }
+}
diff --git a/app/src/main/java/dev/suicode/nativehost/NativeLanguageServices.kt b/app/src/main/java/dev/suicode/nativehost/NativeLanguageServices.kt
new file mode 100644
index 0000000..4942346
--- /dev/null
+++ b/app/src/main/java/dev/suicode/nativehost/NativeLanguageServices.kt
@@ -0,0 +1,46 @@
+package dev.suicode.nativehost
+
+import dev.blamspot.jcode.core.distro.LspCatalogEntry
+import dev.suicode.packages.Capability
+import dev.suicode.packages.PackKind
+import kotlinx.serialization.json.*
+
+/** Translates authorized native Kit declarations to the existing generic LSP client. */
+object NativeLanguageServices {
+    private fun dependenciesEnabled(row: NativePackageRow,rows: List<NativePackageRow>): Boolean = row.pack.manifest.getValue("dependencies").jsonArray.all { dep ->
+        rows.any { it.record.enabled && it.record.id==dep.jsonObject.getValue("id").jsonPrimitive.content }
+    }
+    fun entries(rows: List<NativePackageRow>,onError: (String)->Unit): List<LspCatalogEntry> = rows.filter {
+        it.record.enabled && dependenciesEnabled(it,rows) && it.pack.kind==PackKind.KIT && Capability.LSP in it.record.grants && Capability.RUN in it.record.grants && Capability.FILE_READ in it.record.grants
+    }.flatMap { row ->
+        row.pack.declarations().filter { it.type=="lsp" }.mapNotNull { c ->
+            runCatching {
+                val args=c.descriptor.getValue("arguments").jsonObject
+                fun text(key: String)=args.getValue(key).jsonPrimitive.content
+                fun list(key: String)=Json.parseToJsonElement(text(key)).jsonArray.map { it.jsonPrimitive.content }
+                LspCatalogEntry(
+                    ownerPackage=row.record.id,id=text("serverId"),category="sui-code IDE Kit",name=text("name"),description=row.record.id,
+                    installCommand=text("installCommand"),verifyCommand=text("verifyCommand"),uninstallCommand=text("uninstallCommand"),
+                    runCommand=text("runCommand"),languageIds=list("languageIds"),extensions=list("extensions"),rootDetectors=list("rootDetectors"),initializationOptions=text("initializationOptions")
+                )
+            }.onFailure { onError("${row.record.id}/${c.id}: incomplete LSP adapter (${it.message})") }.getOrNull()
+        }
+    }
+    fun engines(rows: List<NativePackageRow>,onError: (String)->Unit): List<dev.blamspot.jcode.core.distro.DebugEngineEntry> = rows.filter {
+        it.record.enabled && dependenciesEnabled(it,rows) && it.pack.kind==PackKind.KIT && Capability.DAP in it.record.grants && Capability.RUN in it.record.grants && Capability.FILE_READ in it.record.grants
+    }.flatMap { row ->
+        row.pack.declarations().filter { it.type=="dap" }.mapNotNull { c ->
+            runCatching {
+                val args=c.descriptor.getValue("arguments").jsonObject
+                fun text(key: String)=args.getValue(key).jsonPrimitive.content
+                dev.blamspot.jcode.core.distro.DebugEngineEntry(
+                    id=text("id"),category="sui-code IDE Kit",name=text("name"),description=row.record.id,
+                    installCommand=text("installCommand"),verifyCommand=text("verifyCommand"),uninstallCommand=text("uninstallCommand"),
+                    ownerPackage=row.record.id,adapterCommand=text("adapterCommand"),transport=text("transport"),debugType=text("debugType"),
+                    extensions=Json.parseToJsonElement(text("extensions")).jsonArray.map { it.jsonPrimitive.content }
+                )
+            }.onFailure { onError("${row.record.id}/${c.id}: incomplete DAP adapter (${it.message})") }.getOrNull()
+        }
+    }
+
+}
diff --git a/app/src/main/java/dev/suicode/nativehost/NativePackageCenter.kt b/app/src/main/java/dev/suicode/nativehost/NativePackageCenter.kt
