+name: Deliver sui-code native 0.4 complete IDE
+on:
+  push:
+    branches: [sui-code/final-product]
+    paths:
+      - '.github/workflows/deliver-sui-code-native-0.4.yml'
+      - '.delivery/sui-code-native-0.4/**'
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  deliver:
+    if: github.repository == 'suidi-guliu/j-code-android' && github.ref == 'refs/heads/sui-code/final-product'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    env:
+      EXPECTED_APK_SHA256: d392d22003dbe8aee0e7cb63669fac8b5285cb7b2f3ab01bb5ade4046ffd4128
+      EXPECTED_APK_BYTES: '86760725'
+    steps:
+      - uses: actions/checkout@v5
+      - name: Verify immutable prebuilt delivery (no rebuild)
+        shell: bash
+        run: |
+          set -euo pipefail
+          cd .delivery/sui-code-native-0.4
+          sha256sum --check --strict SHA256SUMS
+          test "$(stat -c %s sui-code-native-0.4-debug.apk)" = "$EXPECTED_APK_BYTES"
+          printf '%s  %s\n' "$EXPECTED_APK_SHA256" sui-code-native-0.4-debug.apk | sha256sum --check --strict
+      - name: Verify upgrade identity, architecture and original v0.1 signer
+        shell: bash
+        run: |
+          set -euo pipefail
+          signer=$(find "$ANDROID_HOME/build-tools" -type f -name apksigner | sort -V | tail -1)
+          old=.delivery/sui-code-v0.1/sui-code-v0.1-debug.apk
+          new=.delivery/sui-code-native-0.4/sui-code-native-0.4-debug.apk
+          printf '%s  %s\n' 1554f7e7cb7359b4b90161d08e76bf515b0e0805adf4777bdb8851ef23f2cb06 "$old" | sha256sum --check --strict
+          old_cert=$("$signer" verify --print-certs "$old" | awk '/certificate SHA-256 digest:/ {print $NF}')
+          new_cert=$("$signer" verify --print-certs "$new" | awk '/certificate SHA-256 digest:/ {print $NF}')
+          test "$old_cert" = "$new_cert"
+          test "$new_cert" = 62c2da3484d337626eac6711e5ea7015913e23b8932e9f2b2bd220b843579fa0
+          "$(dirname "$signer")/aapt" dump badging "$new" > "$RUNNER_TEMP/native-badging.txt"
+          grep -F "package: name='dev.suicode.ide.debug' versionCode='1070802' versionName='0.4.0'" "$RUNNER_TEMP/native-badging.txt"
+          grep -F "native-code: 'arm64-v8a'" "$RUNNER_TEMP/native-badging.txt"
+      - name: Verify SDK, full source, specifications and six real packages
+        shell: python
+        run: |
+          import pathlib, zipfile, json, hashlib
+          root=pathlib.Path('.delivery/sui-code-native-0.4')
+          with zipfile.ZipFile(root/'source.zip') as z:
+              names=z.namelist()
+              for suffix in ['app/src/main/java/dev/suicode/nativehost/NativePackageHost.kt','docs/specifications/SUIC-SUIK-Development-Specification.md','docs/specifications/SuiCode-UI-Design-Specification.md']:
+                  assert any(n.endswith('/'+suffix) for n in names), suffix
+          with zipfile.ZipFile(root/'native-sdk.zip') as z:
+              assert any(n.endswith('/API-SOURCE-SHA256SUMS') for n in z.namelist())
+          with zipfile.ZipFile(root/'official-packages.zip') as z:
+              index=json.loads(z.read('official-packages/index.json'))
+              assert len(index['packages'])==6
+              for item in index['packages']:
+                  data=z.read('official-packages/'+item['url'].rsplit('/',1)[1])
+                  assert len(data)==item['bytes'] and hashlib.sha256(data).hexdigest()==item['sha256']
+                  assert data[:8] in [b'SUICPKG\0',b'SUIKPKG\0']
+      - name: Upload complete native IDE delivery
+        id: upload
+        uses: actions/upload-artifact@v4
+        with:
+          name: sui-code-native-0.4-complete
+          path: .delivery/sui-code-native-0.4/*
+          if-no-files-found: error
+          include-hidden-files: true
+          compression-level: 0
+          retention-days: 30
+      - name: Download uploaded artifact for byte-for-byte verification
+        uses: actions/download-artifact@v4
+        with:
+          artifact-ids: ${{ steps.upload.outputs.artifact-id }}
+          path: ${{ runner.temp }}/native-roundtrip
+          merge-multiple: true
+      - name: Verify downloaded files and publish real download entry
+        shell: bash
+        env:
+          DOWNLOAD_DIR: ${{ runner.temp }}/native-roundtrip
+          ARTIFACT_URL: ${{ steps.upload.outputs.artifact-url }}
+          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
+        run: |
+          set -euo pipefail
+          (cd "$DOWNLOAD_DIR" && sha256sum --check --strict SHA256SUMS)
+          test "$(stat -c %s "$DOWNLOAD_DIR/sui-code-native-0.4-debug.apk")" = "$EXPECTED_APK_BYTES"
+          for source in .delivery/sui-code-native-0.4/*; do
+            cmp "$source" "$DOWNLOAD_DIR/$(basename "$source")"
+          done
+          echo UPLOAD_DOWNLOAD_ROUND_TRIP_PASSED
+          {
+            echo '## sui-code native 0.4 delivery verified'
+            printf '[Download complete artifact](%s) · [Workflow run](%s)\n\n' "$ARTIFACT_URL" "$RUN_URL"
+            printf 'APK: **%s bytes** · SHA-256 `%s`\n\n' "$EXPECTED_APK_BYTES" "$EXPECTED_APK_SHA256"
+            echo 'Identity dev.suicode.ide.debug, versionCode 1070802, ARM64; original v0.1 signer matches.'
+            echo 'APK, full source, standalone SDK, six signed packages, public specifications, report, patch and evidence uploaded and downloaded identically. No Release or main change.'
+          } >> "$GITHUB_STEP_SUMMARY"
