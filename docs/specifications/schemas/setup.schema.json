{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suicode:setup:3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "source": {
            "type": "string",
            "pattern": "^https://[^/]+",
            "maxLength": 1024
          },
          "provider": {
            "enum": [
              "environment",
              "ubuntu-apt",
              "kit-resource"
            ]
          },
          "files": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^/(opt/sui-code|usr|bin|lib)/[A-Za-z0-9_./+*-]+$"
            }
          },
          "commands": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9+_.-]{0,79}$"
            }
          },
          "anyCommands": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9+_.-]{0,79}$"
            }
          },
          "packages": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9+.-]{0,79}$"
            }
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "environmentId": {
            "enum": [
              "java",
              "cpp",
              "c",
              "python"
            ]
          },
          "resource": {
            "type": "string",
            "pattern": "^resources/[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "source",
          "provider",
          "files",
          "commands",
          "packages",
          "bytes"
        ]
      }
    }
  },
  "required": [
    "requirements"
  ]
}
