{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "text": {
      "type": "string",
      "maxLength": 65536
    },
    "status": {
      "enum": [
        "ready",
        "loading",
        "empty",
        "error"
      ]
    }
  },
  "required": [
    "title",
    "text",
    "status"
  ]
}
