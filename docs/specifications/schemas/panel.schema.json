{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "text": {
      "type": "string",
      "maxLength": 65536
    },
    "status": {
      "enum": [
        "ready",
        "loading",
        "empty",
        "error"
      ]
    },
    "nodes": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "required": [
    "title",
    "text",
    "status"
  ],
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,63}$"
            },
            "type": {
              "const": "column"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "required": [
            "id",
            "type",
            "children"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,63}$"
            },
            "type": {
              "const": "row"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "required": [
            "id",
            "type",
            "children"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,63}$"
            },
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "id",
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,63}$"
            },
            "type": {
              "const": "metric"
            },
            "text": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "id",
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,63}$"
            },
            "type": {
              "const": "input"
            },
            "label": {
              "type": "string",
              "maxLength": 4096
            },
            "value": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "id",
            "type",
            "label",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,63}$"
            },
            "type": {
              "const": "toggle"
            },
            "label": {
              "type": "string",
              "maxLength": 4096
            },
            "value": {
              "enum": [
                "true",
                "false"
              ]
            }
          },
          "required": [
            "id",
            "type",
            "label",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,63}$"
            },
            "type": {
              "const": "button"
            },
            "label": {
              "type": "string",
              "maxLength": 4096
            },
            "command": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,63}$"
            }
          },
          "required": [
            "id",
            "type",
            "label",
            "command"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,63}$"
            },
            "type": {
              "const": "table"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "maxLength": 80
              }
            },
            "rows": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "maxLength": 4096
                }
              }
            }
          },
          "required": [
            "id",
            "type",
            "columns",
            "rows"
          ]
        }
      ]
    }
  }
}
