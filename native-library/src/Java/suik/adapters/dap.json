{"adapterCommand":"vscode.java.startDebugSession","debugType":"java","extensions":"[\".java\"]","id":"java-debug","installCommand":"printf '%s\\n' 'IDE component installation is managed in Packages > IDE Kit Library. Review the component plan there.' >&2; exit 78","name":"Java debugger","transport":"lsp","uninstallCommand":"echo 'Debug tools are retained with the environment; disable the Kit to stop using them.'; exit 1","verifyCommand":"test -r /opt/sui-code/ide/java/current/java-debug.jar && test -r /opt/sui-code/java.env","workflow":"{\"steps\":[{\"id\":\"main\",\"command\":\"vscode.java.resolveMainClass\",\"arguments\":[\"${projectUri}\"],\"select\":{\"field\":\"filePath\",\"equals\":\"${source}\",\"path\":true,\"fallbackSingle\":true},\"retryEmpty\":30},{\"id\":\"build\",\"command\":\"vscode.java.buildWorkspace\",\"arguments\":[{\"projectName\":\"${main.projectName}\",\"mainClass\":\"${main.mainClass}\",\"isFullBuild\":false}],\"jsonArguments\":true,\"expect\":1},{\"id\":\"paths\",\"command\":\"vscode.java.resolveClasspath\",\"arguments\":[\"${main.mainClass}\",\"${main.projectName}\"]},{\"id\":\"port\",\"command\":\"vscode.java.startDebugSession\",\"arguments\":[]}],\"launch\":{\"type\":\"java\",\"request\":\"launch\",\"mainClass\":\"${main.mainClass}\",\"projectName\":\"${main.projectName}\",\"classPaths\":\"${paths.1}\",\"modulePaths\":\"${paths.0}\",\"cwd\":\"${project}\",\"console\":\"integratedTerminal\",\"stopOnEntry\":false},\"port\":\"${port}\"}"}